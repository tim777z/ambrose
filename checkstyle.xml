<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE checkstyle PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/checkstyle-1.3.dtd">
<checkstyle>
  <module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
      <!-- Missing Javadoc on public method -->
      <module name="JavadocMethod">
        <property name="methodNames"
          value="public protected private package"/>
      </module>

      <!-- Missing Javadoc on class -->
      <module name="JavadocType"/>

      <!-- No TODO comments without explanation -->
      <module name="AvoidDuplicateLiterals"/>

      <!-- Method rules -->
      <module name="MethodLength">
        <property name="max" value="50"/>
      </module>

      <!-- Class rules -->
      <module name="ClassObjectGrouping"/>

      <!-- Import rules -->
      <module name="AvoidStarImport"/>
      <module name="AcyclicImport"/>

      <!-- Line length -->
      <module name="LineLength">
        <property name="max" value="200"/>
      </module>

      <!-- Redundant import -->
      <module name="RedundantImport"/>
    </module>

    <module name="SuppressionFilter">
      <property name="suppressions">
        <checkstyle:map>
          <checkstyle:entry key="Checker"
            value="SaintExuperyCheck"/>
        </checkstyle:map>
      </property>
    </module>
  </module>

  <module name="ProjectChecker">
    <property name="violations" value="5"/>
  </module>
</checkstyle>