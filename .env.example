# Ambrose Environment Variables
#
# See https://github.com/twitter/ambrose for more information.

# HBase/Zookeeper configuration (for HRavenStatsWriteService)
# HBASE_CONF_DIR= path/to/hbase/conf
# HBASE_ZOOKEEPER_QUOROR=zk1:2181,zk2:2181,zk3:2181

# Pig configuration
# PIG_HOME= path/to/pig/installation

# Hive configuration
# HIVE_CONF_DIR= path/to/hive/conf

# Demo configuration
AMBROSE_PORT=8080