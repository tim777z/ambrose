# Ambrose environment variables
# See https://github.com/twitter/ambrose for full documentation

# ===== Server Configuration =====
AMBROSE_PORT=8080
AMBROSE_LOG_LEVEL=INFO

# ===== HBase/Zookeeper (required for hRaven stats persistence) =====
# Set HRAVEN_HBASE_CONF_DIR to the directory containing hbase-site.xml
# Required if using hRaven stats persistence; leave commented out for demo mode
# e.g., HRAVEN_HBASE_CONF_DIR=/path/to/hbase/conf

# ===== Pig/Hive Configuration =====
# Paths to installed runtimes - required for Pig/Hive workflow support
# PIG_HOME=/path/to/pig
# HIVE_HOME=/path/to/hive

# ===== Authentication/Authorization (if enabled) =====
AMBROSE_AUTH_ENABLED=false

# ===== Logging =====
AMBROSE_LOG_LEVEL=INFO

# TLS/SSL configuration (if reverse proxying)
# Set AMBROSE_SSL_ENABLED=true to require HTTPS connections.
# AMBROSE_SSL_KEYSTORE_PATH=/path/to/keystore
# AMBROSE_SSL_KEYSTORE_PASSWORD=changeit

# ===== Docker/Docker Compose =====
# Use 'docker compose up' to start the Ambrose demo server
# on http://localhost:8080/workflow.html?localdata=large
# Docker Compose brings up the demo server and optional backing services.

# Debugging
# AMBROSE_DEBUG_MODE=false

# ===== Security - API Token =====
# Generated token for API access (optional)
# Generate a random token and set it here to enable API authentication.
# When AMBROSE_AUTH_ENABLED=true, the API will reject requests without a valid token.
# AMBROSE_API_TOKEN=your-token-here

# ===== hRaven Configuration =====
# Path to hRaven HBase configuration directory
# Required for persisting job statistics to hRaven's HBase backend
HRAVEN_HBASE_CONF_DIR=/path/to/hbase/conf

# Client-facing URL for the Ambrose web UI
AMBROSE_BASE_URL=http://localhost:8080

# ===== Feature Flags =====
AMBROSE_FEATURE_AUTH_ENABLED=false
